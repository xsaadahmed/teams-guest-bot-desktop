# Copy to .env for local development (optional — Settings UI saves most values).
# Never commit .env or .teams-bot-config.json.

# --- LLM (AI summaries) ---
# LLM_GATEWAY_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_ALLOW_UI_OVERRIDE=1

# --- Identity ---
# LOCAL_PARTICIPANT_NAME=Your Teams Display Name
# DEFAULT_DISPLAY_NAME=e& Assistant

# --- Transcription (optional; faster-whisper or NeMo must be installed in Python) ---
# TRANSCRIPTION_ENGINE=faster_whisper
# TRANSCRIPTION_MODEL=small
# PYTHON_PATH=C:\Path\To\python.exe
# AUTO_TRANSCRIBE=1

# --- Server ---
# PORT=3000
# OPEN_WEB_UI=1

# --- Paths (Electron sets these automatically when packaged) ---
# RECORDINGS_DIR=
# TEAMS_BOT_CONFIG_PATH=
# TEAMS_BOT_BROWSER_PROFILE=
# TEAMS_BOT_TEMP_DIR=
# TEAMS_BOT_USE_SYSTEM_TEMP=0

# --- Playwright / browser (dev / portable bundle) ---
# PLAYWRIGHT_BROWSERS_PATH=0
# CHROME_PATH=
# DISABLE_ROSTER_AUTOMATION=0

# --- WASAPI audio (advanced) ---
# WASAPI_NO_MIC=false
# WASAPI_RENDER_DEVICE=
# WASAPI_MIC_DEVICE=
